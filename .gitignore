# Dataset and Training
dataset/
detected_defects/
# Скачанные датасеты (fetch_freshness_dataset.py) и веса (train_freshness.py).
# Комментарий обязан быть на отдельной строке: в .gitignore текст после паттерна
# считается частью самого паттерна, и правило перестаёт работать.
data/
models/*.pt
freshness_results/

# Logs and Reports
*.log
app.log
*.json
# Метрики обученной модели — маленькие и важны для истории, держим в git
!models/freshness_metrics.json

# Media Output (Too large for Git).
# Видео в репозиторий не кладём — кроме демо-ролика в assets/, который
# пересобирается командой `main_freshness.py --record assets/demo.mp4`.
*.mp4
!assets/*.mp4
_source_clips/
_defect_frames/

# Source media for README (large / regenerable) — assets/ kept, see below
example.mp4
example.jpg

# Verification renders (regenerable via verify_hud.py)
_verify_*.png

# IDEs and Editors
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
